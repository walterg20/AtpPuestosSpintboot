<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ar.com.atp</groupId>
    <artifactId>atp-puestos-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>atp-nucleo-compartido</artifactId>
  <packaging>jar</packaging>

  <name>ATPPuestos-NucleoCompartido</name>
  <description>
    Nucleo compartido del monorepo ATP: catalogos (8 maestros), personas, base de seguridad
    y la API REST /api/v1. Es una libreria: no expone aplicacion ejecutable ni configuracion
    de despliegue; la aporta el modulo atp-puestos-camineros, que es el unico artefacto
    desplegable. No debe contener reglas de negocio de un modulo concreto.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!--
      T-101 / D-36: el nucleo aloja las vistas Thymeleaf del catalogo (D-26), por lo que sus
      `templates/` deben renderizarse desde el jar desplegable => la dependencia va en scope
      `compile` (el de por defecto). Sin `thymeleaf-layout-dialect` (SA-P09 / D-07 de 00-alcance):
      los fragmentos `th:replace` alcanzan sin el dialecto.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <!--
      T-101 (modulo 03-login): el nucleo aloja la configuracion de seguridad del sistema
      (`nucleo.config.SeguridadConfig`), que hereda el artefacto desplegable. La dependencia va en
      scope `compile` porque el `SecurityFilterChain` del nucleo forma parte de su API publica.
      NOTA: la prohibicion anterior de Spring Security en el nucleo (D-36) queda SUPERADA por la
      spec aprobada de 03-login: la politica de seguridad (permitAll en `/api/v1/**`, CSRF
      descartado en `/api/**`, CSRF exigido en las rutas MVC) debe ser la del nucleo, no la
      autoconfiguracion por defecto de Spring Boot.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      T-101 / T-312: utilidades de prueba de Spring Security (`csrf()`, `@WithMockUser`) para los
      slices `@WebMvcTest` del nucleo (los formularios MVC exigen token CSRF).
    -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
