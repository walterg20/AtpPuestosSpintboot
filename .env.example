# ATPPuestos — Plantilla de variables de entorno
# Copiar a `.env` y completar los valores reales. NUNCA versionar `.env`.

# === Base de datos de la aplicación (SQL Server: `Rentas`) ===
DB_HOST=devmssqlatp.ecom.com.ar
DB_PORT=1433
DB_NAME=Rentas
DB_USER=
DB_PASSWORD=
DB_DRIVER=com.microsoft.sqlserver.jdbc.SQLServerDriver
# Cadena completa (alternativa a las variables anteriores). Preferir en el backend:
# spring.datasource.url=jdbc:sqlserver://${DB_HOST}:${DB_PORT};databaseName=${DB_NAME};encrypt=true;trustServerCertificate=false
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# === Perfil de Spring ===
SPRING_PROFILES_ACTIVE=dev

# === Servidor ===
SERVER_PORT=8080
# URL publica de la app: se usa para los enlaces absolutos de las plantillas y para
# construir redirects tras el login.
APP_BASE_URL=http://localhost:8080

# === Seguridad (spec 02-login) ===
# La UI Thymeleaf usa sesion HTTP + CSRF (no JWT): la sesion vive en el servidor.
SECURITY_SESSION_TIMEOUT_MINUTES=30
# `true` exige HTTPS para la cookie de sesion. Dejar en `false` solo en desarrollo.
SECURITY_COOKIE_SECURE=false
SECURITY_COOKIE_HTTPONLY=true
SECURITY_COOKIE_SAMESITE=Lax

# === Auditoria ===
# Usuario por defecto mientras no exista sesion autenticada (R-033).
APP_AUDITORIA_USUARIO=SISTEMA
